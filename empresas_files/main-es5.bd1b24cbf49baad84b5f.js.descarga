],handleKeydown:[{type:n.HostListener,args:["keydown",["$event"]]}],handleKeypress:[{type:n.HostListener,args:["keypress",["$event"]]}],handleKeyup:[{type:n.HostListener,args:["keyup",["$event"]]}],handlePaste:[{type:n.HostListener,args:["paste",["$event"]]}]},t.CurrencyMaskDirective=l},uxwW:function(e,t,o){"use strict";o.d(t,"a",(function(){return n})),o("oDx5"),o("MWAf"),o("lABp"),o("51tA"),o("P4Jt"),o("5s9t");var n=function(){function e(t,o,n,a,i,r,l,s){_classCallCheck(this,e),this.router=t,this.toastService=o,this.authSession=n,this.successHandler=a,this.errorHandler=i,this.actualizaComponentsService=r,this.data=l,this.addAfiliacionQrapidoAsync=s,this.checked=!1,this.resultado=[],this.termino='<p align="center"><strong>OFERTA P&Uacute;BLICA</strong></p><p align="center"><strong>CONDICIONES GENERALES DE PAGOCLAVE (P2C) DEL</strong></p><p align="center"><strong>BANCO DE VENEZUELA, S.A. BANCO UNIVERSAL</strong></p><p style="text-align: center;"><strong>&nbsp;</strong></p><p style="text-align: justify;">Yo, <strong>JOS&Eacute; JAVIER MORALES</strong>, venezolano, mayor de edad, titular de la c&eacute;dula de identidad No. <strong>V- 12.075.438</strong>, actuando en mi car&aacute;cter de Presidente del <strong>BANCO DE VENEZUELA, S.A. BANCO UNIVERSAL</strong>, designado mediante el&nbsp; Decreto Presidencial N&deg; 3.066, de fecha seis (06) de septiembre de dos mil diecisiete (2017), publicado en Gaceta Oficial de la Rep&uacute;blica Bolivariana de Venezuela&nbsp; N&deg; 41.230, de fecha seis (06) de septiembre de dos mil diecisiete (2017), suficientemente facultado para este acto de conformidad con lo dispuesto en el art&iacute;culo 40, numeral 3, de los Estatutos Sociales del<strong> BANCO, </strong>Banco de Venezuela, S.A. Banco Universal, empresa del Estado venezolano, cuyas acciones fueron adquiridas mediante Contrato de Compraventa de Acciones suscrito en fecha tres (03) de julio de dos mil nueve (2009), formalizado el traspaso de las acciones en Asamblea General Extraordinaria de Accionistas celebrada en fecha tres (03) de julio de dos mil nueve (2009), publicada en la Gaceta Oficial de la Rep&uacute;blica Bolivariana de Venezuela N&ordm; 39.266 de fecha diecisiete (17) de septiembre de dos mil nueve (2009) y adscrito al <strong>MINISTERIO DEL PODER POPULAR DE ECONOM&Iacute;A Y FINANZAS</strong>, conforme al Decreto N&ordm; 6.850, de fecha cuatro (04) de agosto de dos mil nueve (2009), publicado en la Gaceta Oficial de la Rep&uacute;blica Bolivariana de Venezuela N&ordm; 39.234 de misma fecha, modificada la denominaci&oacute;n en diversas oportunidades, siendo la &uacute;ltima reforma la establecida en el Decreto N&deg; 2.651 de fecha cuatro (04) de enero de dos mil diecisiete (2017), publicado en la Gaceta Oficial de la Rep&uacute;blica Bolivariana de Venezuela N&deg; 41.067 de fecha cuatro (04) de enero de dos mil diecisiete&nbsp; (2017),&nbsp; domiciliado en la ciudad de Caracas, constituido originalmente por ante el Juzgado de Primera Instancia en lo Civil del Distrito Federal, en el Tercer Trimestre de mil ochocientos noventa (1890), bajo el N&ordm; 33, Folio 36 vto. del Libro Protocolo Duplicado, inscrita en el Registro de Comercio del Distrito Federal el d&iacute;a dos (02) de septiembre de mil ochocientos noventa (1890), bajo el N&ordm; 56, modificados sus Estatutos Sociales en diversas oportunidades, siendo su &uacute;ltima reforma la que consta de asiento inscrito en el Registro Mercantil Segundo del Distrito Capital en fecha diecinueve (19) de enero de dos mil diecis&eacute;is (2016), bajo el N&ordm; 22, Tomo 14-A SDO., con Registro &Uacute;nico de Informaci&oacute;n Fiscal (R.I.F.) N&ordm; <strong>G-20009997-6</strong>, ha resuelto establecer las &ldquo;<strong>CONDICIONES GENERALES DE PAGOCLAVE (P2C) DEL BANCO DE VENEZUELA, S.A. BANCO UNIVERSAL</strong>&rdquo;, en los t&eacute;rminos que se indican a continuaci&oacute;n:</p><p style="text-align: justify;"><strong><u>CL&Aacute;USULA PRIMERA</u></strong><strong>: DEFINICIONES</strong>.</p><p style="text-align: justify;">A los fines de facilitar la interpretaci&oacute;n de esta Oferta P&uacute;blica, las palabras que se se&ntilde;alan a continuaci&oacute;n tendr&aacute;n el significado aqu&iacute; expuesto, bien se utilicen en singular o en plural:</p><p style="text-align: justify;"><strong><u>CONDICIONES GENERALES:</u></strong> Significa la <strong>&ldquo;OFERTA P&Uacute;BLICA DE PAGOCLAVE (P2C) DEL BANCO DE VENEZUELA, S.A. BANCO UNIVERSAL&rdquo;, </strong>As&iacute; como las eventuales modificaciones que <strong>EL BANCO</strong> efectu&eacute; a dicho documento conforme a lo establecido en el mismo.</p><p style="text-align: justify;">1.1 <strong><u>EL BANCO</u>: </strong>Significa el <strong>BANCO DE VENEZUELA, S.A. BANCO UNIVERSAL</strong>, identificado en el encabezado de estas <strong>CONDICIONES GENERALES.</strong></p><p style="text-align: justify;">1.2. <strong><u>EL CLIENTE</u></strong>: Es la persona jur&iacute;dica que ha solicitado los servicios ofrecidos por el<strong> BANCO </strong>para abrir una <strong>CUENTA</strong>, quien luego de afiliarse a <strong>PAGOCLAVE, </strong>conforme al procedimiento dise&ntilde;ado al efecto por <strong>EL BANCO</strong>, podr&aacute; recibir fondos de manera electr&oacute;nicas a trav&eacute;s de una <strong>L&iacute;nea de Telefon&iacute;a M&oacute;vil.</strong></p><p style="text-align: justify;">1.3.<strong> <u>PAGADOR:</u></strong> Es la persona natural que realiza la transferencia de fondos al <strong>CLIENTE </strong>mediante una SMS o una aplicaci&oacute;n dise&ntilde;ada para tal fin</p><p style="text-align: justify;">1.4. <strong><u>DISPOSITIVO MOVIL:</u></strong> Equipo electr&oacute;nico donde <strong>EL CLIENTE</strong> realizara o recibir&aacute; el&nbsp; SMS o tendr&aacute; instalada la aplicaci&oacute;n de pago.</p><p style="text-align: justify;">1.5. <strong><u>APLICATIVO:</u></strong> Programa inform&aacute;tico instalado en el dispositivo m&oacute;vil a trav&eacute;s del cual <strong>EL BANCO</strong> presta el servicio <strong>PAGOCLAVE.</strong></p><p style="text-align: justify;">1.6. <strong><u>CL@VENET EMPRESARIAL</u></strong>: Es el servicio de Banca por internet del Banco de Venezuela para personas jur&iacute;dicas a trav&eacute;s de la direcci&oacute;n <a href="http://www.bancodevenezuela.com">https://www.bancodevenezuela.com</a>.</p><p style="text-align: justify;">1.7. <strong><u>BDVENL&Iacute;NEA:</u></strong> Es el nuevo servicio de Banca por Internet del Banco de Venezuela acceder por la direcci&oacute;n <a href="http://www.bancodevenezuela.com">https://www.bancodevenezuela.com</a>.</p><p style="text-align: justify;">1.8. <strong><u>PAGOCLAVE BANCO DE VENEZUELA:</u></strong> Servicio Pago M&oacute;vil que permite a las personas naturales, realizar pagos entre cuentas del<strong> BANCO</strong> &nbsp;y de otros bancos, a trav&eacute;s del env&iacute;o de un SMS o de una aplicaci&oacute;n descargable utilizando &uacute;nicamente el n&uacute;mero telef&oacute;nico m&oacute;vil del beneficiario del pago. Este servicio permitir&aacute; a las personas jur&iacute;dicas, firmas personales y profesionales colegiados recibir pagos a trav&eacute;s de la mismo modalidad.</p><p style="text-align: justify;">1.9. <strong><u>SMS:</u></strong> <strong>MENSAJES SMS (SHORT MESSAGING SYSTEM):</strong> Servicio disponible en los tel&eacute;fonos m&oacute;viles que permite el env&iacute;o de mensajes cortos entre tel&eacute;fonos m&oacute;viles, tel&eacute;fonos fijos y otros dispositivos de mano.</p><p style="text-align: justify;">1.10. <strong><u>TERMINAL FINANCIERO </u></strong>: Herramienta administrativa y transaccional de la Red de Oficinas del Banco.</p><p style="text-align: justify;">1.11. <strong><u>CLAVEM&Oacute;VIL:</u></strong> Es el servicio que presta <strong>EL BANCO</strong> que consiste en el uso de la tecnolog&iacute;a de la telefon&iacute;a celular, mediante el cual, los <strong>CLIENTES</strong> previamente afiliados y/o registrados, podr&aacute;n recibir en sus respectivos tel&eacute;fonos celulares, alertas y notificaciones relacionadas con sus instrumentos financieros, realizar pagos en el Banco o interbancarios, adem&aacute;s de disponer de un &nbsp;mecanismo que le remitir&aacute; hacer solicitudes de informaci&oacute;n de saldos y/o de los &uacute;ltimos movimientos realizados sobre dichos instrumentos, as&iacute; como de cualquier otra operaci&oacute;n u transacciones que se incorporen a ese sistema, en un todo conforme con la definici&oacute;n del servicio solicitado por &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<strong>EL CLIENTE</strong> en la fecha de la suscripci&oacute;n.</p><p style="text-align: justify;">1.12. <strong><u>TOKEN:</u></strong> Clave alfanum&eacute;rica enviada a trav&eacute;s de SMS al n&uacute;mero registrado en <strong>EL BANCO</strong> que nuestros clientes utilizan para confirmar su identidad en las operaciones que realicen a trav&eacute;s de los <strong>CANALES ELECTR&Oacute;NICOS.</strong></p><p style="text-align: justify;">1.13. <strong><u>SERVICIO TELEF&Oacute;NICO</u></strong>: Es el sistema automatizado que presta <strong>EL</strong> <strong>BANCO</strong> a trav&eacute;s de un n&uacute;mero telef&oacute;nico, por medio del cual <strong>EL CLIENTE</strong>, mediante el mecanismo que el servicio automatizado le indique en cada oportunidad y de acuerdo al suministro de determinados datos, puede impartir las correspondientes instrucciones para realizar operaciones con su cuenta. Los t&eacute;rminos y condiciones que regulan el <strong>SERVICIO TELEF&Oacute;NICO</strong>, est&aacute;n contenidos en las &ldquo;<strong>CONDICIONES GENERALES DE LAS TRANSACCIONES ELECTR&Oacute;NICAS DEL BANCO DE VENEZUELA, S.A. BANCO UNIVERSAL</strong>&rdquo;.</p><p style="text-align: justify;">1.14. <strong><u>LINEA TELEFONICA:</u></strong> Es el n&uacute;mero telef&oacute;nico m&oacute;vil asignado al <strong>CLIENTE</strong> por una operadora de telefon&iacute;a m&oacute;vil autorizada para actuar en la Rep&uacute;blica Bolivariana de Venezuela, y que <strong>EL CLIENTE</strong> asocia a <strong>PAGOCLAVE.</strong></p><p style="text-align: justify;"><strong><u>CLAUSULA SEGUNDA:</u></strong> <strong>DEL OBJETO</strong>.</p><p style="text-align: justify;">El presente documento tiene por objeto regular las relaciones entre <strong>EL BANCO</strong> y <strong>EL</strong> <strong>CLIENTE</strong> derivadas el uso de nuestro servicio <strong>PAGOCLAVE</strong>, para recibir pagos mediante transferencias electr&oacute;nicas a trav&eacute;s de la <strong>L&iacute;nea de Telefon&iacute;a M&oacute;vil</strong>.</p><p style="text-align: justify;"><strong><u>CL&Aacute;USULA TERCERA</u></strong>: <strong>CONDICIONES GENERALES PARA DISFRUTAR EL SERVICIOS: El CLIENTE</strong> deber&aacute; cumplir con los siguientes requisitos.</p><p style="text-align: justify;">3.1. Ser cliente jur&iacute;dico</p><p style="text-align: justify;">3.2. Tener una cuenta en <strong>EL BANCO</strong>.</p><p style="text-align: justify;">3.3. Poseer al menos una (1) l&iacute;nea telef&oacute;nica para asociar al servicio.</p><p style="text-align: justify;">3.3. Estar afiliado a la Banca por Internet para Personas Jur&iacute;dicas. &nbsp;</p><p style="text-align: justify;">3.4. Formalizar la afiliaci&oacute;n a <strong>PAGOCLAVE</strong> como receptor de fondos a trav&eacute;s de los <strong>CANALES ELECTR&Oacute;NICOS</strong> o <strong>TERMINAL FINANCIERO</strong>, cumpliendo con los procesos establecidos para ello.</p><p style="text-align: justify;">3.5. Para la modalidad de la versi&oacute;n m&oacute;vil se deber&aacute; contar con un celular inteligente y descargar la APP en la tienda virtual que corresponda.&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p><p style="text-align: justify;"><strong><u>CL&Aacute;USULA CUARTA</u></strong><strong>: TRANSFERENCIAS ELECTR&Oacute;NICAS. </strong>Las transferencias electr&oacute;nicas ser&aacute;n ejecutadas de acuerdo a las instrucciones giradas por <strong>EL PAGADOR</strong>, sin perjuicio que <strong>EL BANCO</strong> establezca un l&iacute;mite m&aacute;ximo diario y por operaci&oacute;n a las transferencias electr&oacute;nicas, y que <strong>EL PAGAGOR</strong>, establezca sus propios l&iacute;mites dentro de aquellos establecidos conforme a lo expuesto en este documento. <strong>El BANCO</strong> queda exento de cualquier responsabilidad o indemnizaci&oacute;n si no fuere posible ejecutar las operaciones por fallas en el servicio de telefon&iacute;a m&oacute;vil o por cualquier otra circunstancia no imputable a <strong>EL BANCO</strong>.</p><p style="text-align: justify;"><strong><u>CL&Aacute;USULA QUINTA</u></strong><strong>:</strong> <strong>DE LAS RESPONSABILIDADES DEL CLIENTE. </strong></p><p style="text-align: justify;"><strong>El CLIENTE</strong> es responsable de:</p><p style="text-align: justify;">5.1. Utilizar los canales electr&oacute;nicos dispuestos para las transacciones de <strong>PAGOCLAVE</strong>, seg&uacute;n las condiciones establecidas por <strong>EL BANCO</strong>.</p><p style="text-align: justify;">5.2. <strong>EL CLIENTE</strong> se hace responsable de las operaciones recibidas desde su (s) n&uacute;mero (s) telef&oacute;nico (s) m&oacute;vil (es) registrado (s) y validado (s) en los sistemas del <strong>BANCO</strong>.</p><p style="text-align: justify;">5.3. No permitir que terceras personas manipulen los tel&eacute;fonos celulares asociados al servicio <strong>PAGOCLAVE</strong> si no fueron debidamente registrados en el proceso de afiliaci&oacute;n comercial.&nbsp;</p><p style="text-align: justify;">5.4. En el caso de robo, hurto o extrav&iacute;o alguno de los tel&eacute;fonos celulares afiliados, <strong>EL CLIENTE </strong>deber&aacute; notificar de inmediato al <strong>BANCO</strong> y a su proveedor de servicios para que procedan a inactivar dicho dispositivo, as&iacute; como cualquier otra medida que se considere necesaria para la seguridad de las operaciones.</p><p style="text-align: justify;"><strong><u>CL&Aacute;USULA SEXTA</u></strong><strong>: DE</strong><strong> LAS RESPONSABILIDADES DEL BANCO. </strong></p><p style="text-align: justify;"><strong>El BANCO</strong> es responsable de:</p><p style="text-align: justify;">6.1. Notificar a nuestros clientes cada operaci&oacute;n recibida</p><p style="text-align: justify;">6.2 Disponer de un reporte a trav&eacute;s de la Banca por Internet para la consulta de todas las operaciones recibidas.</p><p style="text-align: justify;">6.3. Disponer de los canales de atenci&oacute;n de reclamos, soporte t&eacute;cnico y asesor&iacute;a para el uso del servicio.</p><p style="text-align: justify;"><strong><u>CL&Aacute;USULA S&Eacute;PTIMA:</u></strong><strong> DE LAS COMISIONES.</strong></p><p style="text-align: justify;">Las comisiones y dem&aacute;s gastos que se generen por motivo de las prestaciones de servicio <strong>PAGOCLAVE</strong>, ser&aacute;n establecidas por <strong>EL BANCO</strong>, dentro los l&iacute;mites m&aacute;ximos establecidos y regulados por el Banco Central de Venezuela y que se encuentran publicadas en el Tarifario vigente en nuestra p&aacute;gina p&uacute;blica. <strong>El BANCO</strong> no procesara operaciones cuando los clientes no presenten fondos disponibles para el cobro de la comisi&oacute;n derivada de dicha operaci&oacute;n.</p><p style="text-align: justify;"><strong><u>CL&Aacute;USULA OCTAVA</u></strong>: <strong>DE LAS NORMAS Y PROCEDIMIENTOS.</strong></p><p style="text-align: justify;"><strong>&nbsp;El CLIENTE </strong>conviene en ajustarse a las normas y procedimientos que <strong>EL BANCO</strong> le comunique v&iacute;a electr&oacute;nica o por escrito en materia de <strong>PAGOCLAVE</strong> a que este documento refiere, las cuales formaran parte integrante del mismo, en el entendido de que dichas normas y procedimientos podr&aacute;n ser modificadas en cualquier tiempo por <strong>EL BANCO</strong> cuando haya necesidades de &iacute;ndole financiero, legal, administrativo, tecnol&oacute;gico u operativo as&iacute; lo ameriten, para lo cual <strong>EL BANCO</strong> efectuar&aacute; la respectiva notificaci&oacute;n a <strong>EL CLIENTE</strong> con por lo menos un (01) mes de anticipaci&oacute;n a la fecha que se tenga prevista para su entrada en vigencia. <strong>El CLIENTE</strong> podr&aacute; rechazar la notificaci&oacute;n, mediante comunicaci&oacute;n escrita dirigida al <strong>BANCO</strong>. En tal caso, el presente documento se entender&aacute; por terminado. En caso de que <strong>EL CLIENTE</strong> no notifique por escrito su rechazo dentro del plazo antes indicado, se entender&aacute; que acepta y se adhiere a los nuevos t&eacute;rminos y condiciones de este documento.</p><p style="text-align: justify;"><strong><u>CL&Aacute;USULA NOVENA</u></strong><strong>: DE LAS CAUSALES EXIMENTES DE RESPONSABILIDAD.</strong></p><p style="text-align: justify;"><strong>El BANCO</strong> no asumir&aacute; ning&uacute;n tipo de responsabilidad frente al <strong>CLIENTE</strong>; en consecuencia, no estar&aacute; obligado al pago de indemnizaci&oacute;n alguna por concepto de los da&ntilde;os y perjuicios que eventualmente se deriven de:</p><p style="text-align: justify;">9.1. El incumplimiento total o parcial de las obligaciones que se encuentran a su cargo en virtud de este documento, cuando tal incumplimiento obedezca a ocurrencia de cualquier caso fortuito, razones de fuerza mayor o cualquier otra causa extra&ntilde;a no imputable al <strong>BANCO</strong>. Se consideran causas de fuerza mayor a las perturbaciones civiles, terremotos inundaciones, incendios, guerras, acciones de gobierno por parte de las autoridades civiles y militares, motines, huelgas, hecho de naturaleza u otros eventos, en el entendido que la anterior menci&oacute;n tiene car&aacute;cter eminentemente enunciativo y de modo alguno limitativo o taxativo.</p><p style="text-align: justify;">9.2. El incumplimiento de las obligaciones que se encuentran a su cargo cuando el mismo se derive o fuere consecuencia del incumplimiento de las obligaciones contra&iacute;das por <strong>EL CLIENTE</strong> en este documento.</p><p style="text-align: justify;">9.3. Fallas no imputables a <strong>EL BANCO</strong> producidas en los equipos de computaci&oacute;n.</p><p style="text-align: justify;">9.4. Fallas o desperfectos en la l&iacute;nea de telefon&iacute;a m&oacute;vil del <strong>CLIENTE </strong>y en la trasmisi&oacute;n de la data por causas imputables a los operadores de telefon&iacute;a m&oacute;vil respectiva &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</p><p style="text-align: justify;">9.5. Operaciones no reconocidas por el cliente, pero realizadas desde el dispositivo m&oacute;vil asociado.</p><p style="text-align: justify;">9.6. <strong>EL BANCO</strong> no asumir&aacute; ninguna responsabilidad por los defectos o inconveniente en los bienes y servicios pagados por los usuarios a trav&eacute;s de este canal.</p><p style="text-align: justify;">9.7. Las fallas derivadas de las empresas proveedoras del servicio telef&oacute;nico a los usuarios.</p><p style="text-align: justify;"><strong><u>CL&Aacute;USULA D&Eacute;CIMA</u></strong><strong>: SUSPENSION DEL SERVICIO PAGOCLAVE. </strong></p><p style="text-align: justify;">Por razones de orden t&eacute;cnico, de seguridad, de mantenimiento u otra circunstancia justificada, <strong>EL BANCO</strong> podr&aacute; restringir o suspender temporalmente el servicio referido en este documento. <strong>El BANCO</strong> no ser&aacute; responsable por la interrupci&oacute;n imprevista o sobrevenida del servicio <strong>PAGOCLAVE</strong> por dificultades en su funcionamiento, o por retardo en el tiempo de las operaciones derivadas de las fallas en el servicio el&eacute;ctrico, congestionamiento en la Red o por cualquier otra circunstancia no imputable al <strong>BANCO</strong>.</p><p style="text-align: justify;">Por tal motivo<strong>, EL CLIENTE</strong> garantizar&aacute; el buen uso del canal de pago ajustado a su actividad comercial</p><p style="text-align: justify;"><strong><u>&nbsp;</u></strong></p><p style="text-align: justify;"><strong><u>&nbsp;</u></strong></p><p style="text-align: justify;"><strong><u>&nbsp;</u></strong></p><p style="text-align: justify;"><strong><u>CL&Aacute;USULA D&Eacute;CIMA PRIMERA</u></strong><strong>:</strong> <strong>DEL SERVICIO DE TELEFONIA MOVIL.</strong></p><p style="text-align: justify;">El servicio <strong>PAGOCLAVE</strong> es ofrecido a trav&eacute;s del servicio de telefon&iacute;a m&oacute;vil cuya adquisici&oacute;n y mantenimiento corre por la exclusiva cuenta y riesgo de <strong>EL CLIENTE</strong>, quien elige a su discreci&oacute;n: (I) El proveedor de servicio de telefon&iacute;a m&oacute;vil: (II) La&nbsp; cobertura o plan contratado para usar la l&iacute;nea de telefon&iacute;a m&oacute;vil;(III) El costo del servicio; (IV) La forma y el medio de pago para mantener activa la l&iacute;nea de telefon&iacute;a m&oacute;vil; (V) Cualquier otra circunstancia que elija el proveedor de servicios de telefon&iacute;a m&oacute;vil para mantener habilitado y activo el servicio de telefon&iacute;a m&oacute;vil.</p><p style="text-align: justify;">&nbsp;</p><p style="text-align: justify;"><strong><u>PARAGRAFO UNICO:</u></strong> Cualquier cancelaci&oacute;n, falla, interrupci&oacute;n, restricci&oacute;n, suspensi&oacute;n u otra circunstancia que impida el acceso al servicio de telefon&iacute;a m&oacute;vil deber&aacute; ser resuelta y solucionada directamente por <strong>EL CLIENTE</strong> con su proveedor de servicios de telefon&iacute;a m&oacute;vil y por tanto, <strong>EL BANCO</strong> no tiene ninguna responsabilidad del costo, calidad, vigencia, ni con ning&uacute;n otro aspecto derivado directa o indirectamente de la relaci&oacute;n entre <strong>EL CLIENTE</strong> y su proveedor de servicio de telefon&iacute;a m&oacute;vil. <strong>El BANCO</strong> tampoco ser&aacute; responsable, ni asumir&aacute; ning&uacute;n costo, gasto ni indemnizaci&oacute;n si por cualquier circunstancia no fuere posible instalar la aplicaci&oacute;n en el dispositivo m&oacute;vil adquirido por <strong>EL CLIENTE</strong> y, en consecuencia, queda liberado de cualquier responsabilidad en este particular.&nbsp;&nbsp;</p><p style="text-align: justify;"><strong><u>&nbsp;</u></strong></p><p style="text-align: justify;"><strong><u>CL&Aacute;USULA D&Eacute;CIMA SEGUNDA</u></strong><strong>: OTRAS DECLARACIONES DE EL CLIENTE. </strong></p><p style="text-align: justify;"><strong>El CLIENTE </strong>declara expresamente lo siguiente:</p><p style="text-align: justify;">12.1. Que de conformidad con lo dispuesto en las Normas Relativas a la Protecci&oacute;n a los Usuarios y Usuarias de los Servicios Financieros vigente dictadas por la Superintendencia de las Instituciones del Sector Bancario (SUDEBAN), con anterioridad a la aceptaci&oacute;n del presente documento, cuyo texto ser&aacute; publicado en la p&aacute;gina web de <strong>EL BANCO</strong>, dispuso del tiempo suficiente para examinar su contenido y comprender el preciso alcance, trascendencia y consecuencias jur&iacute;dicas de todas y cada una de las clausulas que lo &nbsp;conforman, las cuales aceptan sin reparo y objeci&oacute;n alguna, por constituir las mismas reflejo fiel y exacto de su voluntad.</p><p style="text-align: justify;">12.2. Que los fondos que ingresen y egresen de la cuenta tienen un origen l&iacute;cito, dando as&iacute; fiel cumplimiento de la Resoluci&oacute;n N&deg; 119.10 emitida por la Superintendencia de las Instituciones del Sector Bancario (SUDEBAN), mediante la cual se dictan las Normas Relativas a la Administraci&oacute;n y Fiscalizaci&oacute;n de los Riesgos Relacionados con los Delitos de Legitimaci&oacute;n de Capitales y Financiamiento al terrorismo.</p><p style="text-align: justify;">12.3. Que no utilizara el servicio que con la aceptaci&oacute;n de este documento <strong>EL BANCO</strong> coloca a su disposici&oacute;n para efectuar operaciones con fondos provenientes de actividades il&iacute;citas o a favor de terceros relacionados, directa o indirectamente, con actividades de esa naturaleza.</p><p style="text-align: justify;">12.4. Que <strong>EL BANCO</strong> le inform&oacute; el contenido de la Resoluci&oacute;n N&deg; 119.10 &ldquo;Normas Relativas a la Administraci&oacute;n y Fiscalizaci&oacute;n de los Riesgos Relacionados con los Delitos de Legitimaci&oacute;n de Capitales y Financiamiento al Terrorismo&rdquo;, promulgadas al efecto por la Superintendencia de las Instituciones del Sector Bancario (SUDEBAN), en fecha 09 de marzo de 2.010 las cuales permiten a dicho Organismo el control, inspecci&oacute;n, vigilancia, supervisi&oacute;n y fiscalizaci&oacute;n de la operaciones que puedan realizarle a trav&eacute;s del Sistema Financiero Venezolano relacionadas con dichos delitos.</p><p style="text-align: justify;">12.5. Que acepta en su totalidad las condiciones establecidas en este documento mediante firma f&iacute;sica de las reglas de negocios o firma electr&oacute;nica, igualmente declara haber ingresado a la Banca por Internet y utilizado los factores de autenticaci&oacute;n se&ntilde;alados en la Resoluci&oacute;n N&deg; 641.10 &ldquo;Normas que Regulan el Uso de la Banca Electr&oacute;nica&rdquo;, de fecha 23 de diciembre de 2.010, al efecto por la Superintendencia de las Instituciones del Sector Bancario (SUDEBAN); por lo tanto, le atribuye su voluntad y consentimiento con los t&eacute;rminos y condiciones aqu&iacute; previstos, de modo que dicha aceptaci&oacute;n equivaldr&aacute; y sustituir&aacute; a la firma aut&oacute;grafa.</p><p style="text-align: justify;"><strong><u>CL&Aacute;USULA D&Eacute;CIMA TERCERA</u></strong><strong>: DE LAS NOTIFICACIONES.</strong></p><p style="text-align: justify;">Todas las comunicaciones o notificaciones que est&eacute;n relacionadas con este documento podr&aacute;n ser realizadas por lo que respecta al cliente mediante cualquiera de las siguientes formas: (I) Aviso publicado en la p&aacute;gina web del <strong>BANCO</strong>;(II) A la direcci&oacute;n de <strong>EL CLIENTE</strong> que se encuentre registrada en la base de datos del <strong>BANCO</strong>. Las notificaciones u comunicaciones se consideran debidamente realizadas y legalmente recibidas por &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<strong>EL CLIENTE</strong>: a) Al d&iacute;a h&aacute;bil siguiente de la publicaci&oacute;n del aviso en la p&aacute;gina web del <strong>BANCO</strong> y b) Al d&iacute;a h&aacute;bil siguiente del env&iacute;o del correo electr&oacute;nico. Las notificaciones o comunicaciones se presumir&aacute;n recibidas por <strong>EL CLIENTE</strong> sin que sea necesario que este acuse de recibido las misma. <strong>El CLIENTE</strong> asume bajo su exclusiva responsabilidad la obligaci&oacute;n de configurar la bandeja de entrada de su cuenta de correo electr&oacute;nico. De modo tal que las comunicaciones o notificaciones enviadas por <strong>EL BANCO</strong> por este medio no sean rechazadas, consideradas como &ldquo;correo basura&rdquo; o excedan la capacidad disponible. <strong>El CLIENTE</strong> se obliga a avisar cualquier cambio de direcci&oacute;n. Asimismo, &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<strong>EL CLIENTE</strong> libera expresamente <strong>AL BANCO</strong> de cualquier responsabilidad derivada directa o indirectamente de cualquier notificaci&oacute;n o comunicaci&oacute;n remitida a una direcci&oacute;n que no se corresponda con la vigente, cuando ello sea debido a la falta de aviso oportuno a que refiere esta Clausula. Todas las comunicaciones que hubiere de dirigir <strong>EL CLIENTE</strong> a <strong>EL BANCO</strong> tendr&aacute;n que realizarse exclusivamente por escrito o mediante correo certificado&nbsp;&nbsp;</p><p>&nbsp;</p>'}return 