("_"),weekdays:"Domingo_Segunda-feira_Ter\xe7a-feira_Quarta-feira_Quinta-feira_Sexta-feira_S\xe1bado".split("_"),weekdaysShort:"Dom_Seg_Ter_Qua_Qui_Sex_S\xe1b".split("_"),weekdaysMin:"Do_2\xaa_3\xaa_4\xaa_5\xaa_6\xaa_S\xe1".split("_"),weekdaysParseExact:!0,longDateFormat:{LT:"HH:mm",LTS:"HH:mm:ss",L:"DD/MM/YYYY",LL:"D [de] MMMM [de] YYYY",LLL:"D [de] MMMM [de] YYYY HH:mm",LLLL:"dddd, D [de] MMMM [de] YYYY HH:mm"},calendar:{sameDay:"[Hoje \xe0s] LT",nextDay:"[Amanh\xe3 \xe0s] LT",nextWeek:"dddd [\xe0s] LT",lastDay:"[Ontem \xe0s] LT",lastWeek:function(){return 0===this.day()||6===this.day()?"[\xdaltimo] dddd [\xe0s] LT":"[\xdaltima] dddd [\xe0s] LT"},sameElse:"L"},relativeTime:{future:"em %s",past:"h\xe1 %s",s:"segundos",ss:"%d segundos",m:"um minuto",mm:"%d minutos",h:"uma hora",hh:"%d horas",d:"um dia",dd:"%d dias",w:"uma semana",ww:"%d semanas",M:"um m\xeas",MM:"%d meses",y:"um ano",yy:"%d anos"},dayOfMonthOrdinalParse:/\d{1,2}\xba/,ordinal:"%d\xba",week:{dow:1,doy:4}})}(o("wd/R"))},"8oFz":function(e,t,o){"use strict";let n={nombre:"CONDICIONES GENERALES DE AFILIACI\xd3N DE COMERCIOS A LOS MEDIOS DE PAGO DEL BANCO DE VENEZUELA, S.A. BANCO UNIVERSAL",subtitulo:"",terminos:"El <b>BANCO DE VENEZUELA, S.A. BANCO UNIVERSAL,</b> empresa del Estado venezolano, cuyas acciones fueron adquiridas para el Estado venezolano mediante Contrato de Compraventa de Acciones suscrito en fecha tres (3) de julio de dos mil nueve (2009), formalizado el traspaso de las acciones en Asamblea General Extraordinaria de Accionistas celebrada en fecha tres (3) de julio de dos mil nueve (2009), publicada en la Gaceta Oficial de la Rep\xfablica Bolivariana de Venezuela N\xba 39.266 de fecha diecisiete (17) de septiembre de dos mil nueve (2009) adscrito al <b>MINISTERIO DEL PODER POPULAR DE ECONOM\xcdA Y FINANZAS,</b> conforme al Decreto N\xba 6.850, de fecha cuatro (4) de agosto de dos mil nueve (2009), publicado en la Gaceta Oficial de la Rep\xfablica Bolivariana de Venezuela N\xba 39.234 de la misma fecha, modificada su denominaci\xf3n por la de <b> MINISTERIO DEL PODER POPULAR DE ECONOM\xcdA, FINANZAS Y COMERCIO EXTERIOR,</b> , conforme al Decreto N\xb0 4.310 de fecha quince (15) de septiembre de dos mil veinte (2020), publicado en la Gaceta Oficial de la Rep\xfablica Bolivariana de Venezuela N\xb0 41.965 de la misma fecha, domiciliado en la ciudad de Caracas, constituido originalmente ante el Juzgado de Primera Instancia en lo Civil del Distrito Federal, en el Tercer Trimestre de mil ochocientos noventa (1890), bajo el N\xba 33, Folio 36 vto., del Libro Protocolo Duplicado, inscrito en el Registro de Comercio del Distrito Federal, el dos (2) de septiembre de mil ochocientos noventa (1890), bajo el N\xba 56, siendo su \xfaltima modificaci\xf3n Estatutaria la que consta de asiento inscrito en el Registro Mercantil Segundo del Distrito Capital de fecha diecinueve (19) de julio de dos mil veintid\xf3s (2022), bajo el N\xba 23, Tomo 435-A, e inscrito en el Registro \xdanico de Informaci\xf3n Fiscal (R.I.F.), bajo el <b>N\xba G-20009997-6, </b> quien a los efectos del presente documento se denominar\xe1 <b>EL BANCO </b> , ha resuelto establecer las <b> CONDICIONES GENERALES DE AFILIACI\xd3N DE COMERCIOS A LOS MEDIOS PAGO DE EL BANCO DE VENEZUELA, S.A. BANCO UNIVERSAL </b> en los t\xe9rminos que se detallan a continuaci\xf3n: <br>  <b><u>CL\xc1USULA PRIMERA:</u> DEFINICIONES:</b> A los fines de facilitar la interpretaci\xf3n de estas palabras o frases que se se\xf1alan a continuaci\xf3n las mismas tendr\xe1n el significado aqu\xed expuesto, bien se utilicen en singular o en plural, may\xfasculas o min\xfasculas de acuerdo al contexto en el que se presenten.<br> <b>1.1  EL BANCO:</b> Es el <b>BANCO DE VENEZUELA, S.A. BANCO UNIVERSAL</b>, identificado en el encabezado de las presentes <b>CONDICIONES GENERALES</b>. <br> <b>1.2  <u>MEDIOS DE PAGO:</u></b> Son los instrumentos o dispositivos mec\xe1nicos o electr\xf3nicos, a trav\xe9s de los cuales los <b>COMERCIOS </b> evidencian y/o transmiten EL BANCO la informaci\xf3n correspondiente a las TRANSACCIONES efectuadas en sus establecimientos a trav\xe9s PUNTOS DE VENTA (POS), BIOPAGOBDV y BOT\xd3N DE PAGO BDV y cualquier otro MEDIO DE PAGO que sea incorporado posteriormente por EL BANCO.<br> <b> 1.3\t<u>COMERCIO:</u></b> Son los clientes de <b>EL BANCO</b> ya sea persona natural o jur\xeddica a la cual EL BANCO ha provisto de un<b> MEDIO DE PAGO</b>.  <b> 1.4\t<u>CONCENTRADOR DE RED</u></b>: Significa el dispositivo electr\xf3nico utilizado por los <b>PUNTOS DE VENTA (POS)</b>, interconectados entre s\xed a trav\xe9s de un medio f\xedsico, para canalizar electr\xf3nicamente las <b>TRANSACCIONES</b> a un enlace de comunicaci\xf3n conectada con <b>EL BANCO</b>.<br>  <b> 1.5\t<u>LOTE</u></b>: Significa el conjunto de <b>TRANSACCIONES</b> procesadas a trav\xe9s de <b>MEDIOS DE PAGO</b> durante un per\xedodo determinado, enviadas en forma electr\xf3nica a EL BANCO.<br>   <b>1.6\t<u>MONEDEROS ELECTR\xd3NICOS</u></b>: Son los dispositivos electr\xf3nicos conformados por un circuito integrado o microprocesador donde se almacena valor electr\xf3nico, y los cuales, entre otras, realizan las funciones de almacenar la informaci\xf3n del <b>TARJETAHABIENTE</b>, y permitir el d\xe9bito o cargo en las cuentas asociadas, as\xed como la carga y descarga de valor electr\xf3nico, al mismo. Dicho dispositivo estar\xe1 contenido en una tarjeta pl\xe1stica, la cual podr\xe1 o no incluir otras funciones adicionales, tales como <b>TARJETA DE D\xc9BITO o TARJETA DE CR\xc9DITO</b>.<br>   <b>1.7\t<u>C\xd3DIGO DE AFILIACI\xd3N</b></u>: Significa el n\xfamero asignado al <b>COMERCIO</b> por <b>EL BANCO</b>, a los fines de la prestaci\xf3n de los servicios objeto de \xe9stas Condiciones Generales.<br>   <b>1.8  <u>\tN\xdaMERO DE IDENTIFICACI\xd3N PERSONAL (PIN)</b></u>: Significa el n\xfamero secreto de acceso, que el<b> TARJETAHABIENTE</b> ha seleccionado para usar su <b>TARJETA DE D\xc9BITO</b> en un <b>PUNTO DE VENTA (POS)</b>.<br>   <b>1.9\t<u>PUNTOS DE VENTA (POS)</b></u>: Dispositivos electr\xf3nicos utilizados por el negocio o persona afiliada para transmitir y autorizar operaciones de pago que efect\xfaan los consumidores con tarjetas de d\xe9bito, cr\xe9dito y dem\xe1s tarjetas de financiamiento o pago electr\xf3nico, por la adquisici\xf3n de bienes o servicios.<br>   <b>1.10 <u>\tBIOPAGOBDV</b></u>: Dispositivo que permite realizar pagos y cobros de bienes y servicios a trav\xe9s de la autenticaci\xf3n biom\xe9trica de los clientes del sistema bancario nacional y del monedero patria, mediante lectura de huella dactilar, sin necesidad de la presencia de instrumentos financieros.<br>   <b>1.11 <u>\tBOT\xd3N DE PAGO BDV</b></u>: Canal de comercio electr\xf3nico, que autoriza pagos en l\xednea, con productos del BDV y productos de otros bancos, a trav\xe9s de una pasarela de pago que cifra informaci\xf3n sensible de los instrumentos financieros, garantizando que la informaci\xf3n pase de forma segura entre el cliente y el <b>COMERCIO</b>.<br>    <b>1.12 <u>\tTARJETA DE D\xc9BITO</b></u>: Instrumento magn\xe9tico, electr\xf3nico u otra tecnolog\xeda en la que \xe9l o la tarjetahabiente o un tercero ha provisto al emisor el monto hasta el cual puede realizar consumos con la misma.<br>   <b>1.13 <u>\tTARJETA DE CR\xc9DITO</b></u>: Instrumento magn\xe9tico, electr\xf3nico o de cualquier otra tecnolog\xeda de identificaci\xf3n del o la <b> TARJETAHABIENTE </b>y que acredita una relaci\xf3n contractual entre <b>EL BANCO</b> y el <b>TARJETAHABIENTE</b>, en virtud del otorgamiento de un cr\xe9dito a corto plazo o l\xednea de cr\xe9dito a favor del segundo, el cual podr\xe1 ser utilizado para la compra de bienes, servicios, cargos autom\xe1ticos en cuenta u obtenci\xf3n de avances en efectivo, entre otros consumos.<br>   <b>1.14 <u>\tTARJETAS DEL BANCO DE VENEZUELA</b></u>: Son las <b>TARJETAS DE D\xc9BITO</b> y <b>TARJETAS DE CR\xc9DITO</b> emitidas directamente por <b>EL BANCO</b> o a trav\xe9s de un tercero autorizado por \xe9ste.<br>   <b>1.15 <u>\tTARJETAHABIENTE</b></u>: Es la persona natural o jur\xeddica, que, previo contrato con el emisor es habilitado para el uso de un cr\xe9dito, l\xednea de cr\xe9dito o cargo en cuenta, a trav\xe9s de tarjetas de cr\xe9dito, d\xe9bito y prepagadas, y dem\xe1s tarjetas de financiamiento o pago electr\xf3nico.<br>   <b>1.16 <u>\tTRANSACCI\xd3N</b></u>: Significa cualquier operaci\xf3n de compra de bienes y/o servicios, realizada por el <b>TARJETAHABIENTE</b> a trav\xe9s de un <b>MEDIO DE PAGO</b> con su <b>TARJETA DE CR\xc9DITO</b> y/o <b>TARJETA DE D\xc9BITO</b>.<br> <b><u>CL\xc1USULA SEGUNDA</b></u>: DE LA SOLICITUD DE AFILIACI\xd3N: La afiliaci\xf3n a los MEDIOS DE PAGO se realizar\xe1 a trav\xe9s del proceso de autogesti\xf3n desde la banca electr\xf3nica, mediante el cual los clientes de EL BANCO, deber\xe1n solicitar a trav\xe9s de <b>BDVenl\xednea personas</b> o <b>BDVenl\xednea empresas</b>, seg\xfan sea el caso, su c\xf3digo de afiliaci\xf3n comercial, conforme a lo siguiente:<br> <b>2.1.</b> En caso de persona natural, se realizar\xe1 a trav\xe9s de <b>BDVenl\xednea personas</b>, y el cliente solo podr\xe1 solicitar un (1) c\xf3digo de afiliaci\xf3n comercial. <br> <b>2.2.</b> Para persona jur\xeddica, deber\xe1 ser realizado a trav\xe9s de <b>BDVenl\xednea empresas</b>, y el cliente solo podr\xe1 gestionar hasta un m\xe1ximo de tres (3) c\xf3digos de afiliaci\xf3n comercial.<br> <b><u>CL\xc1USULA TERCERA</u>: DE LAS CONDICIONES GENERALES DE AFILIACI\xd3N:</b><br> <b>3.1.</b> El uso de las <b>TARJETAS DE CR\xc9DITO y/o TARJETAS DE D\xc9BITO en los MEDIOS DE PAGO</b>, se limita \xfanicamente a la cancelaci\xf3n de bienes y/o servicios propios del <b>COMERCIO</b>, y en ning\xfan caso podr\xe1 servir para cancelar servicios y/o mercanc\xedas distintas al objeto de la actividad comercial de \xe9ste, as\xed mismo, no podr\xe1 el <b>COMERCIO</b> proporcionar dinero en efectivo al <b>TARJETAHABIENTE</b>, salvo lo dispuesto en la cl\xe1usula novena del presente documento, por cuanto estos cargos podr\xedan no ser reconocidos por <b>EL BANCO</b> y podr\xe1n dar origen a la desafiliaci\xf3n del <b>COMERCIO</b>.<br> <b>3.2.</b> El <b>COMERCIO</b> acepta que el TARJETAHABIENTE pague el importe de los bienes y/o servicios obtenidos en \xe9ste o en el lugar donde se preste el servicio, mediante la utilizaci\xf3n de <b>TARJETAS DE CR\xc9DITO</b> y/o <b>TARJETAS DE D\xc9BITO</b> en los <b>MEDIOS DE PAGO</b>, y deber\xe1 cobrarle los mismos precios establecidos para las ventas con pago en efectivo. Queda expresamente establecido que el <b>COMERCIO</b> no podr\xe1 recargarle al <b>TARJETAHABIENTE</b> el porcentaje que <b>EL BANCO</b> le descuenta al <b>COMERCIO</b> por concepto de comisiones ni ninguna otra cantidad, salv\xf3 a los que establezcan las leyes. El incumplimiento de esta obligaci\xf3n por parte del COMERCIO motivar\xe1 a la aplicaci\xf3n de medidas por parte de <b>EL BANCO</b>, las cuales podr\xe1n incluir la terminaci\xf3n de la relaci\xf3n contractual y el reverso del cargo indebido.<br> <b>3.3.</b> Durante la vigencia de la relaci\xf3n contractual entre <b>EL BANCO</b> y el <b>COMERCIO</b> derivada de las presentes Condiciones Generales, el <b>COMERCIO</b> se obliga a mantener una cuenta corriente activa en EL BANCO. <br> <b>3.4.</b> En caso que el <b>COMERCIO</b> sea una persona jur\xeddica, est\xe1 obligado a informar por escrito a <b>EL BANCO</b> de cualquier modificaci\xf3n realizada a sus Estatutos, as\xed como, tambi\xe9n sobre la sustituci\xf3n y nombramiento de sus administradores dentro de los diez (10) d\xedas siguientes de ocurrido dicho cambio, entregando copia de todos y cada uno de los documentos que evidencien tales hechos. Igualmente, se obliga a notificarle a <b>EL BANCO</b> cualquier decisi\xf3n sobre disoluci\xf3n o liquidaci\xf3n, quiebra o atraso de dicha Sociedad Mercantil.<br> <b>3.5. </b> El COMERCIO no podr\xe1 ceder ni total ni parcialmente los derechos y obligaciones contra\xeddos en raz\xf3n de la presente Oferta P\xfablica.<b> El COMERCIO</b> se obliga a suministrar a EL BANCO toda la informaci\xf3n que \xe9ste le requiera respecto a la utilizaci\xf3n de <b>TARJETAS DE CR\xc9DITO</b> y/o <b>TARJETASDE D\xc9BITO</b> en los <b>MEDIOS DE PAGO</b>.<br> <b><u>CL\xc1USULA CUARTA</u>: DEL PAGO DE LAS TRANSACCIONES:</b><br> <b>EL BANCO</b> pagar\xe1 directamente al <b>COMERCIO</b> mediante el dep\xf3sito en la cuenta corriente abierta por el COMERCIO en <b>EL BANCO</b>, el precio de los bienes y/o servicios que los <b>TARJETAHABIENTES</b> hayan adquirido y/o solicitado, y cuya cancelaci\xf3n fuese realizada mediante la utilizaci\xf3n de <b>TARJETAS DE CR\xc9DITO</b> y/o <b>TARJETAS DE D\xc9BITO</b> en los <b>MEDIOS DE PAGO</b>. <br> <b><u>CL\xc1USULA QUINTA</u>: DE LAS TRANSACCIONES EFECTUADAS CON TARJETA DE CR\xc9DITO:</b><br> <b>5.1. El COMERCIO</b> al efectuar la venta de bienes y/o servicios mediante <b>TRANSACCIONES</b> realizadas a trav\xe9s de <b>TARJETAS DE CR\xc9DITO</b>, se obliga a cumplir con todos y cada uno de los requisitos siguientes: a)verificar que la <b>TARJETA DE CR\xc9DITO</b> no presente alteraciones, mutilaciones, tachaduras, cambios en los colores o cualquier otra alteraci\xf3n que haga dudosa su legitimidad y/o vigencia; b) verificar que los caracteres y n\xfameros grabados en la <b>TARJETA DE CR\xc9DITO</b> se distingan claramente, y que su tama\xf1o, as\xed como los espacios entre sus caracteres sean uniformes; c) que el n\xfamero que encabece la <b>TARJETA DE CR\xc9DITO</b> coincida con el correspondiente a las <b>TARJETA DE CR\xc9DITO</b> pertenecientes a la franquicia d)verificar que el n\xfamero de cuatro (4) d\xedgitos impreso encima o debajo del n\xfamero de la <b>TARJETA DE CR\xc9DITO</b> coincida con los cuatro (4) primeros d\xedgitos del n\xfamero de la TARJETA DE CR\xc9DITO; e) verificar que se encuentra impreso en la TARJETA DE CR\xc9DITO el logotipo y el holograma correspondiente a la franquicia de la <b>TARJETA DE CR\xc9DITO</b>; f) verificar que en el panel de firmas que aparece en el reverso de la <b>TARJETA DE CR\xc9DITO</b> se encuentra la denominaci\xf3n de la franquicia, as\xed como el n\xfamero de la <b>TARJETA DE CR\xc9DITO</b> seguido por un c\xf3digo de seguridad de tres (3) d\xedgitos; g) verificar la identidad del <b>TARJETAHABIENTE</b> confrontando los datos que aparecen en la <b>TARJETA DE CR\xc9DITO</b> con su(s) documento(s) de identificaci\xf3n personal; h) verificar que el <b>TARJETAHABIENTE</b> firme en presencia de un empleado del <b>COMERCIO</b> la nota de consumo.<br> <b>CL\xc1USULA SEXTA: DE LAS TARJETAS DE D\xc9BITO:</b> <b>6.1.</b> Las <b>TRANSACCIONES</b> con <b>TARJETAS DE D\xc9BITO</b> s\xf3lo podr\xe1n ser efectuadas a trav\xe9s de un <b>PUNTO DE VENTA (POS)</b>.<br> <b>6.2. El COMERCIO</b> al efectuar la venta de los bienes y servicios, se obliga a: solicitar al <b>TARJETAHABIENTE</b> la presentaci\xf3n de sus documentos de identificaci\xf3n personal.<br> <b>6.3.</b> El <b>N\xdaMERO DE IDENTIFICACI\xd3N PERSONAL (PIN)</b> del <b>TARJETAHABIENTE</b> es un car\xe1cter secreto e intransferible por lo que el <b>COMERCIO</b> en ning\xfan caso podr\xe1 requerirlo al momento de efectuar la TRANSACCI\xd3N.<br> <b>6.4. El COMERCIO</b> estar\xe1 obligado a proteger la confidencialidad del <b>N\xdaMERO DE IDENTIFICACI\xd3N PERSONAL (PIN) del TARJETAHABIENTE</b> permitiendo a \xe9ste ingresar dicho n\xfamero en condiciones de privacidad, de manera que ni los empleados del <b>COMERCIO</b> ni sus clientes o terceros puedan tener acceso al mismo, todo ello, dentro de las condiciones f\xedsicas propias del COMERCIO y del <b>PUNTO DE VENTA. El COMERCIO</b> deber\xe1 advertir a sus empleados el car\xe1cter secreto del <b>N\xdaMERO DE IDENTIFICACI\xd3N PERSONAL (PIN)</b> de los <b>TARJETAHABIENTES</b>, as\xed como, si por cualquier circunstancia llegar\xe1n a conocerlo est\xe1n obligados a mantenerlo bajo estricta reserva y no suministrarlos a terceras personas.<br> <b><u>CL\xc1USULA S\xc9PTIMA</u>: DE LAS TARJETAS DE EL BANCO.</b><br> <b>7.1.</b> El <b>COMERCIO</b> autoriza a <b>EL BANCO</b> a hacer uso de su denominaci\xf3n comercial en las promociones que realicen y en los directorios que publique relacionados con la utilizaci\xf3n de las tarjetas de <b>EL BANCO</b> durante la vigencia de la relaci\xf3n contractual entre ambos, sin que ello genere contraprestaci\xf3n alguna.<br> <b>7.2.</b> <b>El COMERCIO</b> se obliga a exhibir en lugares visibles, sin contraprestaci\xf3n alguna por parte de <b>EL BANCO</b> el material publicitario y de promociones que \xe9ste le suministre, y que sirva para anunciar que en su establecimiento son admitidas las tarjetas de <b>EL BANCO</b>.<br> <b><u>CL\xc1USULA OCTAVA</u>: COMISIONES:</b><br> <b>8.1 EL BANCO</b> podr\xe1 debitar de la cuenta que mantenga el <b>COMERCIO</b> en la instituci\xf3n bancaria los montos correspondientes a las comisiones y recargos por los conceptos que se indican a continuaci\xf3n: a) procesamiento de <b>TRANSACCIONES</b> efectuadas con <b>TARJETAS DE CR\xc9DITO</b>; b) procesamiento de <b>TRANSACCIONES</b> efectuadas con <b>TARJETA DE D\xc9BITO</b>; c) Instalaci\xf3n del <b>PUNTO DE VENTA (POS)</b> y d) mantenimiento preventivo y correctivo del <b>PUNTO DE VENTA (POS)</b>. El monto de las comisiones y recargos por los servicios prestados por <b>EL BANCO al COMERCIO</b>, as\xed como la periodicidad y oportunidad de su cobro, ser\xe1n anunciados en los tarifarios colocados a la vista del p\xfablico, en las agencias y sucursales de <b>EL BANCO</b>. Las definiciones de los servicios antes referidos se encuentran contenidas en el Manual de Procesos a disposici\xf3n de los <b>COMERCIOS</b> en las agencias y sucursales de <b>EL BANCO</b>.<br> <b>8.2 EL BANCO</b> podr\xe1 exonerar al <b>COMERCIO</b> del pago de todas o alguna de las comisiones indicadas en el numeral anterior.<br> <b><u>CL\xc1USULA NOVENA</u>: DE LOS PUNTOS DE VENTA (POS), BIOPAGOBDV Y BOT\xd3N DE PAGO BDV:</b><br> <b>9.1. EL BANCO </b>colocar\xe1 en los medios electr\xf3nicos el manual de Productos de <b>PUNTO DE VENTA (POS), BIOPAGOBDV y BOT\xd3NDEPAGOBDV</b>.<br> <b>9.2.</b> Los costos y gastos que se originen por la instalaci\xf3n y mantenimiento del <b>PUNTO DE VENTA (POS</b>) ser\xe1n a cargo del <b>COMERCIO</b>, sin perjuicio de lo antes expuesto, <b>EL BANCO</b> no tendr\xe1 injerencia en ning\xfan momento, por el monto de dichos costos de instalaci\xf3n y mantenimiento.<br> <b>9.3. El COMERCIO</b> se obliga a asignarle una clave de reverso al <b>PUNTO DEVENTA (POS)</b> cuyas especificaciones t\xe9cnicas as\xed lo requiera, y que ser\xe1 exigida en caso de que se quiera anular o dejar sin efecto una determinada <b>TRANSACCI\xd3N</b>, o se efect\xfae un reembolso de las cantidades cargadas a las <b>TARJETAS DE CR\xc9DITO</b> y/o <b>TARJETA DE D\xc9BITO</b>, dicha clave de reverso ser\xe1 de car\xe1cter secreto intransferible, por lo que el <b>COMERCIO</b> se hace responsable de todas las consecuencias que se deriven del empleo o utilizaci\xf3n de dicha clave.<br> <b>9.4.</b>En caso de deterioro parcial o total del <b>PUNTO DE VENTA (POS)</b> o fallas en el sistema operativo de \xe9ste, el <b>COMERCIO</b> se obliga a: a) reportarlo de inmediato a <b>EL BANCO</b>; b) permitir al personal debidamente autorizado por <b>EL BANCO</b>, acceso al establecimiento para efectuar mantenimiento preventivo y correctivo del <b>PUNTO DE VENTA (POS)</b>; c) permitir al personal debidamente autorizado por <b>EL BANCO</b> el retiro del <b>PUNTO DE VENTA (POS)</b>, cuando su reparaci\xf3n no pueda ser efectuada en el establecimiento; d) permitir la sustituci\xf3n del <b>PUNTO DE VENTA</b> por otro mientras dure la reparaci\xf3n o, en caso que \xe9sta no pueda ser efectuada, aceptar el nuevo <b>PUNTO DE VENTA (POS)</b> instalado en sustituci\xf3n del anterior.<br> <b>9.5.</b> En caso de deterioro parcial o total del <b>PUNTO DE VENTA (POS)</b> debe ser canalizado a trav\xe9s del Aliado Comercial donde fue adquirido el equipo para efectuar mantenimiento preventivo y correctivo. En caso que aplique el reemplazo o sustituci\xf3n del equipo, el mismo deber\xe1 realizarse directamente con el Aliado Comercial<br> <b><u>CL\xc1USULA D\xc9CIMA:</u> DE LA DESAFILIACI\xd3N DEL COMERCIO:</b><br> <b>10.1.</b> Se consideran causas de terminaci\xf3n de la relaci\xf3n contractual entre <b>EL BANCO</b> y el <b>COMERCIO</b> adem\xe1s de las previstas por el derecho com\xfan y las mencionadas en otras cl\xe1usulas de las presentes Condiciones las siguientes:<br> <b> a)</b> La voluntad de cualquiera de las partes de terminar la relaci\xf3n contractual.<br> <b>b)</b> El incumplimiento por parte del <b>COMERCIO</b> de cualquiera de las obligaciones previstas en este documento.<br> <b>c)</b> La insolvencia, quiebra, suspensi\xf3n o cesaci\xf3n de pagos del COMERCIO.<br> <b>d)</b> El fraude cometido por el <b>COMERCIO</b> en contra de <b>EL BANCO</b> y/o el <b>TARJETAHABIENTE</b>.<br> <b>e)</b> El incumplimiento de las obligaciones crediticias contra\xeddas por el <b>COMERCIO</b> a favor de <b>EL BANCO</b> o con otras instituciones bancarias.<br> <b>f)</b> El suministro de informaci\xf3n falsa o insuficiente a <b>EL BANCO</b>.</b> <b>g)</b> Da\xf1os causados al <b>PUNTO DE VENTA (POS)</b> por causas imputables al <b>COMERCIO</b>.</b> <b>h)</b> El retiro del <b>PUNTO DE VENTA (POS)</b> por parte del <b>COMERCIO</b>.</b> <b>i)</b> La alteraci\xf3n de la programaci\xf3n del <b>PUNTO DE VENTA (POS)</b> sin autorizaci\xf3n de <b>EL BANCO</b>. <b>j)</b> La solicitud de desafiliaci\xf3n del COMERCIO hecha por escrito a EL BANCO a trav\xe9s de cualquiera de sus agencias y/o sucursales.<br> <b>k)</b> La terminaci\xf3n de la relaci\xf3n contractual entre <b>EL BANCO</b> y el <b>COMERCIO</b> no dar\xe1 lugar al pago de indemnizaci\xf3n alguna por parte de <b>EL BANCO al COMERCIO</b>.<br> <b>l)</b> Queda expresamente entendido entre las partes que despu\xe9s de terminada la relaci\xf3n contractual, <b>EL BANCO</b> procesar\xe1 el pago de las <b>TRANSACCIONES</b> pendientes y las acreditar\xe1n en la cuenta del <b>COMERCIO</b>, previa deducci\xf3n de las comisiones y dem\xe1s cantidades pendientes de pago por parte del <b>COMERCIO</b> a <b>EL BANCO</b>, de conformidad con lo dispuesto en las presentes condiciones.<br> <b><u>CL\xc1USULA D\xc9CIMA PRIMERA</u>: DE LA EXENCI\xd3N DE RESPONSABILIDAD DE EL BANCO: </b><br> <b>11.1. EL BANCO</b> queda relevado de toda responsabilidad por cualquier queja, demanda o acci\xf3n legal que pudiese tener su origen en la venta de bienes o servicios por parte del <b>COMERCIO</b>, quien deber\xe1 indemnizar a EL BANCO en caso de que estos hechos acarreen a \xe9ste cualquier tipo de p\xe9rdidas, gastos o pagos de honorarios, este derecho a indemnizaci\xf3n perdurar\xe1 a\xfan despu\xe9s de la terminaci\xf3n de la relaci\xf3n contractual entre <b>EL BANCO</b> y el <b>COMERCIO</b>.<br> <b>11.2. EL BANCO</b> no asumir\xe1 responsabilidad alguna por retrasos, deficiencias o imposibilidad en cuanto a la prestaci\xf3n de los servicios a que se refiere esta oferta p\xfablica debido a caso fortuito, fuerza mayor u otra causa extra\xf1a no imputable a <b>EL BANCO</b>, y en general aquellas circunstancias que est\xe9n fuera de su control.<br> <b><u>CL\xc1USULA D\xc9CIMA SEGUNDA</u>: CONFIDENCIALIDAD: El COMERCIO</b> se obliga a  mantener la informaci\xf3n relacionada con los <b>TARJETAHABIENTES</b>, as\xed como la informaci\xf3n que sea suministrada por <b>EL BANCO</b> para la ejecuci\xf3n de los servicios a que se refiere este documento en la m\xe1s absoluta confidencialidad, quedando entendido que el <b>COMERCIO</b> ser\xe1 responsable por los da\xf1os y perjuicios que el incumplimiento de esta obligaci\xf3n pueda causar.<br> <b><u>CL\xc1USULA D\xc9CIMA TERCERA</u>: NOTIFICACIONES.</b><br> <b>13.1.</b> Cualquier orden, notificaci\xf3n, aviso, comunicaci\xf3n que el COMERCIO deba dirigir a <b>EL BANCO</b> en relaci\xf3n al presente documento, deber\xe1 hacerlo por escrito y en duplicado o por intermedio de las agencias de <b>EL BANCO</b>. Dichas notificaciones, avisos o comunicaciones deben el <b>COMERCIO</b> entregarlas a un funcionario autorizado en cualquier agencia o sucursal de <b>EL BANCO</b>, dicho funcionario dejar\xe1 constancia tanto en el original como en la copia de dicho documento, del d\xeda y la hora en que lo reciba, devolviendo la copia al <b>COMERCIO</b> y conservando para <b>EL BANCO</b> el original.<br>  <b>13.2. El COMERCIO</b> se obliga a notificar inmediatamente a <b>EL BANCO</b> respecto a cualquier cambio de direcci\xf3n o de tel\xe9fono, as\xed como de cualquier modificaci\xf3n en la informaci\xf3n suministrada a \xe9ste con anterioridad, y en tanto dicha notificaci\xf3n no conste como recibida por <b>EL BANCO</b>, se tendr\xe1 como v\xe1lida la informaci\xf3n que reposa en los registros de <b> EL BANCO</b>.<br> <b><u>CL\xc1USULAD\xc9CIMA CUARTA</u>: DISPOSICIONES FINALES.</b><br> <b>14.1</b>\tA partir de la entrada en vigencia de las presente Condiciones Generales dejar\xe1n de aplicarse las estipulaciones contenidas en el \u201cContrato de Afiliaci\xf3n de Comercio del Banco de Venezuela\u201d protocolizado dicho documento en la Oficina Subalterna del Segundo Circuito de Registro del Distrito Federal en fecha 24 de febrero de 1993 bajo el N\xb0 21 Protocolo 3ero, Tomo 6, as\xed como el \u201cContrato Afiliaci\xf3n de Comercio del Banco Caracas\u201d protocolizado ante la Oficina Subalterna del Tercer Circuito del Municipio Libertador del Distrito Federal de fecha 3 de mayo 2020, bajo el N\xb0 22, Tomo 2, Protocolo 3ero.<br> <b>14.2\tEl BANCO</b> Se reserva el derecho de introducir las modificaciones que considere necesarias a las presentes condiciones mediante documento escrito y ser\xe1 posteriormente publicadas en la p\xe1gina p\xfablica de EL BANCO en tales modificaciones entrar\xe1n en vigencia en la fecha que se indica en el documento correspondiente<br> <b>14.3</b>\tPara todos los efectos de la presente condiciones sus derivados y consecuencias se elige como domicilio especial \xfanico y excluyente a la ciudad de Caracas.<br>"};o.d(t,"a",(function(){return a}));class a{constructor(e,t){this.router=e,this.dialog=t,this.htmlStr=n}ngOnInit(){}redirectPagoclaveComercioCreate(){}redirectMenu(){this.router.navigate(["main"])}}},"8rEH":function(e,t,o){"use strict";o.d(t,"p",(function(){return L})),o.d(t,"b",(function(){return m})),o.d(t,"i",(function(){return h})),o.d(t,"e",(function(){return f})),o.d(t,"c",(function(){return p})),o.d(t,"h",(function(){return C})),o.d(t,"d",(function(){return b})),o.d(t,"a",(function(){return P})),o.d(t,"n",(function(){return g})),o.d(t,"k",(function(){return E})),o.d(t,"g",(function(){return R})),o.d(t,"m",(function(){return v})),o.d(t,"j",(function(){return _})),o.d(t,"f",(function(){return S})),o.d(t,"l",(function(){return I})),o.d(t,"o",(function(){return y})),o.d(t,"q",(function(){return O}));var n=o("zQui"),a=o("8bJo"),i=o("KCVW"),l=o("2Vo4"),r=o("XNiG"),s=o("quSY"),d=o("VRyK"),c=o("LRne"),u=o("itXk"),A=o("lJxs");class g extends n.o{constructor(){super(...arguments),this.stickyCssClass="mat-table-sticky"}}class m extends n.b{}class h extends n.j{}class f extends n.f{}class p extends n.d{}class C extends n.i{constructor(e,t){super(e,t),t.nativeElement.classList.add("mat-column-"+e.cssClassFriendlyName)}}class b extends n.e{constructor(e,t){super(e,t),t.nativeElement.classList.add("mat-column-"+e.cssClassFriendlyName)}}class P extends n.a{constructor(e,t){super(e,t),t.nativeElement.classList.add("mat-column-"+e.cssClassFriendlyName)}}class E extends n.l{}class R extends n.h{}class v extends n.n{}class _ extends n.k{}class S extends n.g{}class I extends n.m{}class O extends n.q{}class L{}class y extends a.b{constructor(e=[]){super(),this._renderData=new l.a([]),this._filter=new l.a(""),this._inter