ired.toString(),n["\u0275nov"](t,46).disabled.toString(),n["\u0275nov"](t,46).errorState,n["\u0275nov"](t,46).panelOpen?n["\u0275nov"](t,46)._optionIds:null,n["\u0275nov"](t,46).multiple,n["\u0275nov"](t,46)._ariaDescribedby||null,n["\u0275nov"](t,46)._getAriaActiveDescendant(),n["\u0275nov"](t,46).disabled,n["\u0275nov"](t,46).errorState,n["\u0275nov"](t,46).required,n["\u0275nov"](t,46).empty,n["\u0275nov"](t,50).ngClassUntouched,n["\u0275nov"](t,50).ngClassTouched,n["\u0275nov"](t,50).ngClassPristine,n["\u0275nov"](t,50).ngClassDirty,n["\u0275nov"](t,50).ngClassValid,n["\u0275nov"](t,50).ngClassInvalid,n["\u0275nov"](t,50).ngClassPending])}))}let vt=(()=>{class e{constructor(e){this.apiGateway=e}list(e){let t=new P.a({method:P.a.METHOD_POST,url:a.a.paths.actualizarAceptacionTerminos,headers:{},params:e,debug:P.a.DEBUG_OFF,response:this.apiGateway.responseSuccessFake([{Numero_cuenta:"01020345710000059802",documento:"V24905659",telefono:"04241528620"}])});return this.apiGateway.execute(t)}}return e.ngInjectableDef=n["\u0275\u0275defineInjectable"]({factory:function(){return new e(n["\u0275\u0275inject"](b.a))},token:e,providedIn:"root"}),e})();class _t{constructor(e,t,o,n,a,i,l){this.router=e,this.logoutService=t,this.authSession=o,this.actualizarAceptacionTerminos=n,this.successHandler=a,this.errorHandler=i,this.toastService=l,this.checked=!1,this.termino='<p align="center"><strong>CONDICIONES DE USO DE BDVENLINEA EMPRESAS Y USUARIO UNICO</strong></p><p style="text-align:justify">1.&nbspPara ingresar al servicio <strong>EL CLIENTE</strong> debe utilizar sus credenciales de <strong>Usuario &Uacute;nico.</strong></p><p style="text-align:justify">2.&nbsp<strong>EL CLIENTE</strong> podr&aacute; ingresar a BDVenl&iacute;nea empresas, previamente validado con B&oacute;vedaenl&iacute;neaBDV el cual funge como mecanismo de autenticaci&oacute;n obligatorio para el canal.</p><p style="text-align:justify">3.&nbsp<strong>EL CLIENTE</strong> se obliga con <strong>EL BANCO</strong> a suministrar informaci&oacute;n fidedigna de los siguientes datos: a.- Correo institucional, en caso que dicha direcci&oacute;n sea de dominio p&uacute;blico, es responsabilidad de <strong>EL CLIENTE</strong> la doble verificaci&oacute;n para el acceso a la misma, <NOBR>b.-N&uacute;mero</NOBR> de Registro de Informaci&oacute;n Fiscal (RIF), c.- Raz&oacute;n Social, <NOBR>d.-N&uacute;mero</NOBR> telef&oacute;nico, e.- Direcci&oacute;n f.- N&uacute;mero de Cuenta Principal, y <strong>EL BANCO</strong> se obliga con <strong>EL CLIENTE</strong> a hacer uso estrictamente confidencial de la informaci&oacute;n suministrada por \xe9ste, con la finalidad de verificar su registro.</p><p style="text-align:justify">4.&nbspLos usuarios <strong>M&Aacute;STER</strong> son responsables de:</p><p style="text-align:justify">4.1&nbspDefinir en el m&oacute;dulo de Administradores de perfiles &gt; Perfil empresas, los niveles de aprobaci&oacute;n para cada una de las transacciones inherentes al canal; as&iacute; como, la afiliaci&oacute;n de los productos ofrecidos al cliente jur&iacute;dico.</p><p style="text-align:justify">4.2&nbspDefinir y crear en el m&oacute;dulo de Administradores de perfiles &gt; Perfil usuario, usuarios con el rol de Administrador y/o Administrador operacional.</p><p style="text-align:justify">Las responsabilidades y funciones de los usuarios m&aacute;ster estar&aacute;n regidas bajo la condici&oacute;n de firma de la cuenta de su empresa.</p><p style="text-align:justify">De tal manera que, si la condici&oacute;n de firma es Conjunta, se requiere al menos dos (2) usuarios m&aacute;ster para completar las responsabilidades descritas en los puntos 4.1 y 4.2. Ahora bien, si la condici&oacute;n de firma es Indistinta, se requiere al menos un (1) usuario m&aacute;ster para completar las responsabilidades descritas en los puntos 4.1 y 4.2.</p><p style="text-align:justify">5.&nbspLos usuarios <strong>ADMINISTRADORES:</strong> Ser&aacute;n designados por los usuarios <strong>M&Aacute;STER</strong> y son responsables de:</p><p style="text-align:justify">5.1&nbspDefinir, crear y perfilar en el m&oacute;dulo de Administradores de perfiles &gt; Perfil usuario, a los usuarios <strong>OPERACIONALES</strong>, estando obligados a suministrar informaci&oacute;n cierta.</p><p style="text-align:justify">5.2&nbspSer&aacute;n responsables de la actualizaci&oacute;n de esta informaci&oacute;n.</p><p style="text-align:justify">6.&nbspLos usuarios <strong>OPERACIONALES:</strong> Ser&aacute;n designados por los usuarios <strong>ADMINISTRADORES</strong> y son responsables de:</p><p style="text-align:justify">6.1&nbspCrear, aprobar y ejecutar transacciones financieras y no financieras, ya sean simples y/o complejas a trav\xe9s del canal <strong>BDVenl&iacute;nea empresas.</strong></p><p style="text-align:justify">7.&nbspResponsabilidades comunes a los usuarios <strong>M&Aacute;STER, ADMINISTRADORES</strong> y <strong>OPERACIONALES:</strong></p><p style="text-align:justify">7.1&nbspSer&aacute;n responsables de mantener bajo estricta confidencialidad la <strong>CONTRASE\xd1A</strong>, con la debida diligencia de un buen padre de familia de acuerdo a la legislaci&oacute;n vigente, asumiendo las consecuencias por los da\xf1os y perjuicios que se causaren por la p\xe9rdida o situaci&oacute;n fraudulenta en el uso de la <strong>CONTRASE\xd1A</strong>; en virtud de ello, cualquier transacci&oacute;n que se efect&uacute;e mediante la utilizaci&oacute;n de la <strong>CONTRASE\xd1A</strong> compromete al <strong>EL CLIENTE</strong> directa y exclusivamente, eximiendo de responsabilidad alguna a <strong>EL BANCO,</strong> lo cual significa que son los &uacute;nicos responsables de todas y cada una de las operaciones realizadas en nombre de <strong>EL CLIENTE</strong> a trav\xe9s del canal <strong>BDVenl&iacute;nea empresas,</strong> tales como: modificaci&oacute;n de datos, perfiles y movilizaci&oacute;n de fondos, entre otras.</p><p style="text-align:justify">8.&nbspLos <strong>USUARIOS</strong> declaran que aceptan las condiciones aqu&iacute; establecidas para el uso del servicio a trav\xe9s del canal <strong>BDVenl&iacute;nea empresas</strong></p>'}ngOnInit(){}redirectToMain(){this.actualizarAceptacionTerminos.list({condEstatus:1}).subscribe(this.successHandler.handle(this,this.setAceptacionTerminosSuccess),this.errorHandler.handle(this,this.setAceptacionTerminosError))}setAceptacionTerminosSuccess(e){this.toastService.handle(e.data(),"Ok")}setAceptacionTerminosError(e){this.toastService.handle(e.error.message(),"Ok")}salir(){this.logoutService.handle().subscribe()}}let St=(()=>{class e{constructor(e){this.apiGateway=e}list(){let e=new P.a({method:P.a.METHOD_POST,url:a.a.paths.consultarAceptacionTerminos,headers:{},params:{},debug:P.a.DEBUG_OFF,response:this.apiGateway.responseSuccessFake([{Numero_cuenta:"01020345710000059802",documento:"V24905659",telefono:"04241528620"}])});return this.apiGateway.execute(e)}}return e.ngInjectableDef=n["\u0275\u0275defineInjectable"]({factory:function(){return new e(n["\u0275\u0275inject"](b.a))},token:e,providedIn:"root"}),e})();class It{constructor(e,t,o,n,a,i,l,r,s,d){this.router=e,this.elementRef=t,this.extendSession=o,this.authSession=n,this.dialog=a,this.successHandler=i,this.errorHandler=l,this.toastService=r,this.consultarAceptacionTerminos=s,this.bridgeReceiptService=d,this.dln=!1}ngOnInit(){console.log("terminos condiciones"),this.consultarAceptacionTerminos.list().subscribe(this.successHandler.handle(this,this.getAceptacionTerminosSuccess),this.errorHandler.handle(this,this.getAceptacionTerminosError));const e=this.extendSession.extend().subscribe(()=>{this.time=this.extendSession.time(),null!=this.authSession.getAuthToken()&&null!=this.authSession.getAuthToken()?this.time<5&&(e.unsubscribe(),this.extendSession.logout()):e.unsubscribe()});this.getMainUrl(this.router.url)}getMainUrl(e){e.indexOf("/main")}extend(){this.extendSession.refresh()}ngAfterViewInit(){this.ele